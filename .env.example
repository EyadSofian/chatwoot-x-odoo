APP_ENV=development
LOG_LEVEL=INFO

# Chatwoot self-hosted URL. Example: https://chat.engosoft.com
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_AUTO_PRIVATE_NOTES=false
CHATWOOT_UPDATE_ATTRIBUTES=true
CHATWOOT_UPDATE_SENSITIVE_ATTRIBUTES=false
CHATWOOT_SYNC_ON_MESSAGE_CREATED=false

# Optional shared token for the embedded Dashboard App URL.
# Add it to Chatwoot as: https://your-bridge-domain.com/dashboard?token=...
DASHBOARD_APP_TOKEN=

# Dashboard access rules. By default orders and invoices are hidden from all agents
# until at least one allow-list value is configured.
RESTRICTED_DASHBOARD_SECTIONS=orders,invoices
SENSITIVE_DATA_ALLOWED_AGENT_EMAILS=
SENSITIVE_DATA_ALLOWED_AGENT_IDS=
SENSITIVE_DATA_ALLOWED_AGENT_DOMAINS=

# Odoo 17 self-hosted URL. Example: https://engosoft.com
ODOO_URL=https://engosoft.com
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=

# Security and sync behavior
ALLOW_UNSIGNED_WEBHOOKS=false
WEBHOOK_TOLERANCE_SECONDS=300
SYNC_TTL_SECONDS=1800
MAX_LEADS=5
MAX_ORDERS=5
MAX_INVOICES=5
MAX_COURSES=5
APP_STATE_DB_PATH=data/integration.sqlite3
